---
import Layout from "./Layout.astro";
import MascotGuide from "./MascotGuide.astro";
import tools from "../data/tools.json";

const {
  toolId,
  title,
  description,
  guideTitle,
  guideMessage,
  usageTitle = "使い方のコツ",
  usageLead = "元の内容や伝えたいことを入れて、相手・雰囲気・長さを選ぶだけで文章を整えられます。",
  situations = [],
  tips = [],
  related = [],
  examples = [],
  faq = [],
} = Astro.props;

const tool = tools.find((item) => item.id === toolId);

if (!tool) {
  throw new Error(`Tool not found: ${toolId}`);
}

const seoDescription =
  description ||
  `${tool.title}は、${tool.description}登録不要・無料でブラウザからすぐ使える1分ツールです。`;

const faqSchema = faq.length
  ? {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      mainEntity: faq.map((item) => ({
        "@type": "Question",
        name: item.question,
        acceptedAnswer: {
          "@type": "Answer",
          text: item.answer,
        },
      })),
    }
  : null;
---

<Layout
  title={title || `${tool.title}｜無料の文章作成ツール`}
  description={seoDescription}
  structuredData={faqSchema ? [faqSchema] : []}
>
  <main class="page">
    <div class="container">
      <section class="hero" style="padding-top: 10px;">
        <span class="hero__label">{tool.category}</span>
        <h1>{tool.title}</h1>
        <p>{tool.description}</p>
      </section>

      <MascotGuide title={guideTitle} message={guideMessage} />

      {
        (examples.length > 0 || faq.length > 0) && (
          <nav class="use-page-nav" aria-label="このページ内の目次">
            <strong>すぐ見る</strong>
            <a href="#tool">文章を作る</a>
            {examples.length > 0 && <a href="#examples">完成例</a>}
            <a href="#usage">使い方</a>
            {faq.length > 0 && <a href="#faq">よくある質問</a>}
          </nav>
        )
      }

      <div class="tool-layout" id="tool">
        <section class="panel">
          <h2>入力</h2>
          <div class="hint">内容を入れて、相手・雰囲気・長さを選ぶと、そのまま使いやすい文章に整えます。</div>

          <div class="field">
            <label for="incoming" id="incomingLabel">元の内容・相手から来た文章</label>
            <textarea id="incoming" placeholder="例：相手から来た文章、または伝えたい内容を入力してください"></textarea>
          </div>

          <div class="form-row">
            <div class="field">
              <label for="purpose">目的</label>
              <select id="purpose">
                <option value="reply">返信する</option>
                <option value="decline">断る</option>
                <option value="request">お願いする</option>
                <option value="remind">催促する</option>
                <option value="thanks">お礼する</option>
                <option value="apology">謝る</option>
                <option value="report">報告する</option>
                <option value="rewrite">言い換える</option>
              </select>
            </div>

            <div class="field">
              <label for="relationship">相手</label>
              <select id="relationship">
                <option value="work">仕事相手</option>
                <option value="boss">上司</option>
                <option value="client">取引先</option>
                <option value="customer">お客様</option>
                <option value="friend">友達</option>
                <option value="unknown">まだ関係が浅い相手</option>
              </select>
            </div>
          </div>

          <div class="field">
            <label>雰囲気</label>
            <div class="segmented" data-group="tone">
              <button type="button" data-value="polite" class="active">丁寧</button>
              <button type="button" data-value="soft">やわらかめ</button>
              <button type="button" data-value="casual">自然</button>
            </div>
          </div>

          <div class="field">
            <label>長さ</label>
            <div class="segmented" data-group="length">
              <button type="button" data-value="short" class="active">短め</button>
              <button type="button" data-value="medium">標準</button>
              <button type="button" data-value="long">丁寧に</button>
            </div>
          </div>

          <div class="field">
            <label for="detail" id="detailLabel">入れたい内容</label>
            <textarea id="detail" placeholder="例：理由、希望日、次の対応、補足したいことなど"></textarea>
          </div>

          <div class="actions">
            <button class="button primary" id="generateBtn" type="button">文章を作る</button>
            <button class="button secondary" id="copyBtn" type="button">コピー</button>
            <button class="button secondary" id="clearBtn" type="button">クリア</button>
          </div>
        </section>

        <section class="panel">
          <h2>出力</h2>
          <div id="output" class="output"></div>
          <div class="template-grid">
            <button class="template-button" type="button" data-template-index="0">見本1</button>
            <button class="template-button" type="button" data-template-index="1">見本2</button>
            <button class="template-button" type="button" data-template-index="2">見本3</button>
          </div>
        </section>
      </div>

      <section class="seo-content" id="usage">
        <h2>{usageTitle}</h2>
        <p>{usageLead}</p>
        <div class="info-grid">
          <div>
            <h3>使える場面</h3>
            <ul>
              {situations.map((item) => <li>{item}</li>)}
            </ul>
          </div>
          <div>
            <h3>作るときのポイント</h3>
            <ul>
              {tips.map((item) => <li>{item}</li>)}
            </ul>
          </div>
        </div>
        {
          examples.length > 0 && (
            <>
              <h2 id="examples">そのまま使える完成例</h2>
              <p class="section__note">固有名詞、日時、数字を自分の状況に置き換え、内容を確認してから送ってください。</p>
              <div class="example-list">
                {examples.map((example) => (
                  <article class="example-card">
                    <h3>{example.situation}</h3>
                    <p>{example.text}</p>
                    {example.point && (
                      <p class="example-card__point">
                        <strong>使うポイント：</strong> {example.point}
                      </p>
                    )}
                    <button
                      class="example-copy-button"
                      type="button"
                      data-copy-text={example.text}
                      aria-label={`${example.situation}の例文をコピー`}
                    >
                      例文をコピー
                    </button>
                  </article>
                ))}
              </div>
            </>
          )
        }
        {
          related.length > 0 && (
            <div class="related-tools">
              {related.map((item) => (
                <a href={item.href}>{item.label}</a>
              ))}
            </div>
          )
        }
        {
          faq.length > 0 && (
            <>
              <h2 id="faq">よくある質問</h2>
              <div class="faq-list">
                {faq.map((item) => (
                  <details>
                    <summary>{item.question}</summary>
                    <p>{item.answer}</p>
                  </details>
                ))}
              </div>
            </>
          )
        }
      </section>
    </div>
  </main>
  <div id="toast" class="toast"></div>
  <script type="application/json" id="tool-data" set:html={JSON.stringify(tool)}></script>
  <script is:inline src="/scripts/generic-writing-tool.js"></script>
  {examples.length > 0 && <script is:inline src="/scripts/use-example-copy.js"></script>}
</Layout>
