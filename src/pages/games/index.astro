---
import IconBadge from "../../components/IconBadge.astro";
import Layout from "../../components/Layout.astro";
import MascotGuide from "../../components/MascotGuide.astro";
import games from "../../data/games.json";
import { SITE_URL } from "../../../site.config.mjs";

const gameIcons = {
  反射神経: "game",
  記憶: "example",
  パズル: "tool",
  計算: "minute",
  判断力: "search",
  集中力: "rank",
  戦略: "game",
  迷路: "maze",
  言葉: "word",
};

const featuredGames = ["janken-reaction", "number-order", "sea-battle"]
  .map((slug) => games.find((game) => game.slug === slug))
  .filter(Boolean);
const categories = Array.from(new Set(games.map((game) => game.category)));
const gameCounts = Object.fromEntries(
  categories.map((category) => [category, games.filter((game) => game.category === category).length]),
);

const gameListSchema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: "1分ゲーム",
  itemListElement: games.map((game, index) => ({
    "@type": "ListItem",
    position: index + 1,
    url: new URL(`/games/${game.slug}/`, SITE_URL).toString(),
    name: game.title,
    description: game.description,
  })),
};
---

<Layout
  title="1分ゲーム｜無料ですぐ遊べる暇つぶしミニゲーム"
  description="登録不要で60秒だけ遊べる無料の1分ゲーム集です。反射神経、記憶、マインスイーパー、計算、迷路、海戦などをスマホとPCで楽しめます。"
  structuredData={[gameListSchema]}
>
  <main class="page">
    <div class="container">
      <section class="hero game-hero">
        <span class="hero__label">1分ゲーム</span>
        <h1>無料の暇つぶしゲームを、1分だけ遊ぶ。</h1>
        <p>
          ダウンロードや登録なしで、休憩中や待ち時間にすぐ遊べます。
          反射、記憶、パズル、計算など、60秒でスコアが出るミニゲームを選べます。
        </p>
        <div class="actions">
          <a class="button primary" href="/games/janken-reaction/">じゃんけん反射をすぐ遊ぶ</a>
          <a class="button secondary" href="#game-categories">ゲームを選ぶ</a>
        </div>
      </section>

      <MascotGuide
        title="ゲーム案内"
        message={`${games.length}本の1分ゲームがあります。迷ったら、じゃんけん反射か数字順タップからどうぞ。`}
        variant="game"
      />

      <section class="game-summary" aria-label="1分ゲームの概要">
        <div>
          <span>ゲーム数</span>
          <strong>{games.length}</strong>
        </div>
        <div>
          <span>プレイ時間</span>
          <strong>60秒</strong>
        </div>
        <div>
          <span>記録</span>
          <strong>端末内</strong>
        </div>
      </section>

      <section class="section section--tight">
        <div class="section__head">
          <div>
            <h2>まず遊ぶなら</h2>
            <p class="section__note">ルールがすぐわかるものを先に置いています。</p>
          </div>
        </div>
        <div class="game-grid game-grid--featured">
          {featuredGames.map((game) => (
            <a class="game-card game-card--featured" href={`/games/${game.slug}/`}>
              <div class="card-icon-row">
                <IconBadge name={gameIcons[game.category] || "game"} />
                <span>{game.category}</span>
              </div>
              <strong>{game.time}</strong>
              <h2>{game.title}</h2>
              <p>{game.description}</p>
            </a>
          ))}
        </div>
      </section>

      <section class="section section--tight" id="game-categories" aria-label="1分ゲームカテゴリ">
        <div class="section__head">
          <div>
            <h2>カテゴリから探す</h2>
            <p class="section__note">押すと、そのカテゴリのゲームだけを下に表示します。</p>
          </div>
          <a class="button secondary" href="/games/ranking/">この端末の記録を見る</a>
        </div>
        <div class="category-filter game-category-filter" aria-label="ゲームカテゴリで絞り込み">
          <button type="button" class="category-pill game-category-pill" data-game-category="すべて" aria-pressed="true">
            すべて {games.length}本
          </button>
          {categories.map((category) => (
            <button type="button" class="category-pill game-category-pill" data-game-category={category} aria-pressed="false">
              {category} {gameCounts[category]}本
            </button>
          ))}
        </div>
      </section>

      <section class="section section--tight game-catalog" aria-label="1分ゲーム一覧">
        <div class="section__head section__head--compact">
          <div>
            <h2>ゲーム一覧</h2>
            <p class="section__note" aria-live="polite"><span id="gameCount">{games.length}</span>本を表示しています。</p>
          </div>
        </div>
        <div class="game-grid" id="gameList">
          {games.map((game) => (
            <a class="game-card game-filter-item" href={`/games/${game.slug}/`} data-game-category={game.category}>
              <div class="card-icon-row">
                <IconBadge name={gameIcons[game.category] || "game"} />
                <span>{game.category}</span>
              </div>
              <strong>{game.time}</strong>
              <h3>{game.title}</h3>
              <p>{game.description}</p>
            </a>
          ))}
        </div>
      </section>
    </div>
  </main>
  <script is:inline src="/scripts/game-finder.js"></script>
</Layout>
